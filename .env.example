# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Node-operator outreach automation.
# Delivery is dry-run when gateway URLs are unset.
OPERATOR_OUTREACH_DB="data/operator-outreach.json"
OPERATOR_MIN_CONTACT_INTERVAL_HOURS="48"
OPERATOR_GATEWAY_TIMEOUT_MS="10000"
OPERATOR_EMAIL_WEBHOOK_URL=""
OPERATOR_VOICE_WEBHOOK_URL=""
OPERATOR_GATEWAY_TOKEN=""
OPERATOR_ENABLE_VOICE="false"
OPERATOR_AUTO_REPLY="false"
OPERATOR_OUTREACH_PORT="8790"

# Required to start the inbound webhook server.
# Replace with a cryptographically random secret of at least 32 characters.
OPERATOR_INBOUND_TOKEN="CHANGE_ME_WITH_A_RANDOM_32_PLUS_CHAR_SECRET"

# Web/API production safety.
# Keep simulation mutations disabled for public deployments.
RDL_WEB_DATA_DIR="data"
RDL_CORS_ALLOWED_ORIGINS=""
RDL_MAX_JSON_BODY_KB="256"
RDL_API_REQUESTS_PER_MINUTE="120"
RDL_ENABLE_SIMULATION_API="false"
RDL_ADMIN_TOKEN="CHANGE_ME_WITH_A_RANDOM_32_PLUS_CHAR_SECRET"

# Rust peer node production switch.
# This intentionally fails closed until encrypted peer transport is implemented.
RDL_PRODUCTION_MODE="false"
