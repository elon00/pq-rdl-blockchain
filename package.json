{
  "name": "republic-of-divine-light-rdl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npx --no-install vite build && npx --no-install esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "check:env": "node check-env.mjs",
    "check:truth": "node check-truth.mjs",
    "test:cargo": "cargo test",
    "test:nist": "tsx src/crypto/tests/official-nist-vectors.test.ts",
    "audit:crypto": "node scripts/audit-crypto.mjs",
    "reality:universal": "tsx scripts/reality-universal.ts",
    "reality:certify": "tsx scripts/generate-urs-certificate.ts",
    "test": "npm run check:truth && npm run test:integrity && npm run test:operator && npm run test:cargo && npm run test:nist && npm run audit:crypto && npm run reality:universal && npm run build",
    "qmoosa:finish": "node scripts/qmoosa-reality-finisher.mjs",
    "rdl:finish": "node scripts/rdl-network-finisher.mjs",
    "testnet:genesis-hash": "node scripts/testnet-genesis-hash.mjs",
    "backup:snapshots": "node scripts/backup-snapshots.mjs",
    "build:release": "node scripts/build-release-artifacts.mjs",
    "start:tunnel": "node scripts/start-public-tunnel-node.mjs",
    "preflight:build": "node scripts/preflight-build.mjs",
    "finish:all": "node scripts/finish-all.mjs",
    "deploy:state": "node scripts/sync-deployment-state.mjs",
    "telegram:bot": "node scripts/telegram-node-bot.mjs",
    "test:telegram": "tsx services/telegram-bot/bot.ts --test",
    "testnet:cluster": "docker compose -f docker-compose.testnet.yml up -d",
    "testnet:cluster:down": "docker compose -f docker-compose.testnet.yml down",
    "qualify:testnet": "node scripts/qualify-testnet-1click.mjs",
    "test:integrity": "node --import tsx --test tests/token-integrity.test.ts",
    "test:operator": "node --import tsx --test tests/operator-outreach.test.ts",
    "operator:add": "tsx services/operator-outreach/cli.ts add",
    "operator:list": "tsx services/operator-outreach/cli.ts list",
    "operator:invite": "tsx services/operator-outreach/cli.ts invite",
    "operator:brief": "tsx services/operator-outreach/cli.ts brief",
    "operator:followup": "tsx services/operator-outreach/cli.ts followup",
    "operator:response": "tsx services/operator-outreach/cli.ts response",
    "operator:server": "tsx services/operator-outreach/server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
